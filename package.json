{
  "name": "kilovault",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:client": "crunchy build:client",
    "crunch": "crunchy build",
    "bundle": "tsx scripts/bundle.mts",
    "test": "crunchy build && vitest run",
    "test:nobuild": "vitest run",
    "dev": "nodemon --watch src --ext ts --exec \"pnpm run crunch && pnpm run bundle && pnpm run dev:run\"",
    "dev:run": "deno run --allow-net --allow-env --allow-read=.env --env-file=.env dist/index.js",
    "dev:db": "sqld -d .sqld-local --http-listen-addr 127.0.0.1:8080",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "migrate:prod": "tsx --env-file=.env.production scripts/migrate.ts",
    "dev1": "pnpm run crunch && tsx --watch --env-file=.env src/index.ts",
    "cli": "pnpm --loglevel=error --filter kilovault-cli --silent dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@bunny.net/edgescript-sdk": "^0.12.1",
    "@libsql/client": "^0.17.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "commander": "^12.1.0",
    "crunch.ts": "github:thomkin/crunch.ts#f8878d92618ed42473737ee24bc8b9b3e659c43d",
    "kysely": "^0.28.12",
    "typia": "^12.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.0",
    "cross-env": "^10.1.0",
    "deno": "^2.7.5",
    "esbuild": "^0.27.4",
    "nodemon": "^3.1.14",
    "ts-patch": "^3.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@libsql/core": "0.17.0",
    "@libsql/client": "0.17.0"
  }
}
